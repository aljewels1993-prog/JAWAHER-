# BOUSLA – Supabase configuration.
# Copy to .env.local (never committed) or set these in Netlify → Site configuration
# → Environment variables. Both values are public by design (they ship to the
# browser); data is protected by Row Level Security in the database.
# NEVER put the secret key (sb_secret_…) or the service_role key here.
VITE_SUPABASE_URL=https://svqojttxvfqmimhdlais.supabase.co
# Supabase → Project Settings → API Keys → Publishable key
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key-here

# Preview mode only (no Supabase): teacher code checked in the browser. Default 1993.
# With Supabase the code lives in the database: select public.set_teacher_code('...');
# VITE_TEACHER_CODE=1993
