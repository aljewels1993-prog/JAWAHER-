# BOUSLA – Supabase configuration (copy to .env.local and fill in).
# Find both values in Supabase → Project Settings → API.
# Only the PUBLIC anon key belongs here. NEVER put the service_role key in
# any VITE_ variable: everything prefixed VITE_ is shipped to the browser.
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key

# Preview mode only (no Supabase): teacher code checked in the browser. Default 1993.
# With Supabase the code lives in the database: select public.set_teacher_code('...');
# VITE_TEACHER_CODE=1993
