# Copy to .env to turn on shared online saves, leaderboard and teacher accounts.
# Use the PUBLIC "anon" key from Supabase → Project Settings → API.
# NEVER put the service_role key here — it would be visible to every student.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key
